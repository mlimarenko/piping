{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piping",
  "version": "0.1.0",
  "identifier": "space.piping.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Piping desktop client",
    "longDescription": "Desktop shell for the Piping remote-administration platform.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "windows": {
      "minimumWebview2Version": "110.0.1531.0",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
