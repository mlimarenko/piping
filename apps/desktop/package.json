{
  "name": "piping-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:appimage": "bash scripts/build-linux-bundles.sh --bundles appimage",
    "build:linux": "bash scripts/build-linux-bundles.sh --bundles deb,rpm && bash scripts/build-linux-bundles.sh --bundles appimage",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "build:debug": "tauri build --debug"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
