{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/demo-main.tsx",
    "tests/e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/types/**/*.d.ts",
    // Generated by openapi-typescript from the OpenAPI contract (`pnpm gen:api`);
    // its export surface is the generator's, not ours — hand-pruning is
    // overwritten by the next gen:api run. Exactly one generated file, never a
    // wider pattern: the gate stays fully armed for hand-written code.
    "src/shared/api/schema.gen.ts"
  ],
  // Declared dependency, referenced only by the Vite `resolve.dedupe` list in
  // vite.config.ts — not imported by source, so knip cannot see it. Drop this
  // entry together with that dedupe line.
  "ignoreDependencies": [
    "@tanstack/query-core"
  ],
  "ignoreExportsUsedInFile": true,
  "vite": {
    "config": "vite.config.ts"
  }
}
