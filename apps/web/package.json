{
  "name": "piping-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:all": "tsc -b --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "size": "size-limit",
    "size:initial": "node scripts/check-initial-size.mjs",
    "gen:api": "openapi-typescript ../../apps/api/contracts/piping.openapi.yaml --default-non-nullable false -o src/shared/api/schema.gen.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip:ci": "knip --include files,dependencies"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@sentry/react": "^10.60.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/query-core": "^5.101.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "guacamole-common-js": "^1.5.0",
    "i18next": "^26.3.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^6.10.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^8.3.0",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.14",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "size-limit": [
    {
      "name": "main entry chunk (excluding lazy routes & vendor session libs)",
      "path": "dist/assets/index-*.js",
      "limit": "450 KB"
    },
    {
      "name": "noVNC vendor chunk",
      "path": "dist/assets/vendor-novnc-*.js",
      "limit": "350 KB"
    },
    {
      "name": "guacamole vendor chunk",
      "path": "dist/assets/vendor-guacamole-*.js",
      "limit": "250 KB"
    },
    {
      "name": "xterm vendor chunk",
      "path": "dist/assets/vendor-xterm-*.js",
      "limit": "150 KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/guacamole-common-js": "^1.5.5",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.5.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.20.0",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-checker": "^0.14.4",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
