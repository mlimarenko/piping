{
  "name": "piping-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:all": "tsc -b --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "size": "size-limit",
    "size:initial": "node scripts/check-initial-size.mjs",
    "gen:api": "openapi-typescript ../../apps/api/contracts/piping.openapi.yaml --default-non-nullable false -o src/shared/api/schema.gen.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip:ci": "knip --include files,dependencies"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "^10.78.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/query-core": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-virtual": "^3.14.25",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "guacamole-common-js": "^1.5.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.67.0",
    "maplibre-gl": "^6.16.0",
    "medeo-font": "1.0.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router": "^8.5.1",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "swagger-ui-react": "^5.34.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "size-limit": [
    {
      "name": "main entry chunk (excluding lazy routes & vendor session libs)",
      "path": "dist/assets/index-*.js",
      "limit": "450 KB"
    },
    {
      "name": "guacamole vendor chunk",
      "path": "dist/assets/vendor-guacamole-*.js",
      "limit": "250 KB"
    },
    {
      "name": "xterm vendor chunk",
      "path": "dist/assets/vendor-xterm-*.js",
      "limit": "150 KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/guacamole-common-js": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
