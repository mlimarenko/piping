# Local-dev env-file for docker-compose.yml. The compose file defaults PROD-SAFE
# (mandatory secrets, cookie_secure=true, license enforced); this file supplies
# weak dev secrets and flips the safety toggles back to dev. Loaded by `make up`
# (Makefile passes --env-file env/dev.env). Committed on purpose: dev-only, no
# real secrets. Prod/edge uses its own .env, never this one.
POSTGRES_PASSWORD=piping-dev-password
REDIS_PASSWORD=dev-redis-password
PIPING_PROXY_NODE_ID=00000000-0000-7000-8000-0000000000a2
PIPING_PROXY_NODE_SECRET=dev-proxy-node-secret-0001
PIPING_SECRETS__CIPHER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PIPING_AUTH_PASSWORD_PEPPER=dev-pepper
PIPING_AUTH_COOKIE_SECURE=false
PIPING_SECURITY_ALLOW_WEAK_DEV_SECRETS=true
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=piping

# Local stack cannot reach the public catalog repo; silence the hourly refresh warning.
PIPING_OFFICIAL_CATALOG_REFRESH_ENABLED=false
PIPING_BACKEND_IMAGE=piping-backend:local
PIPING_FRONTEND_IMAGE=piping-frontend:local
PIPING_ANSIBLE_RUNNER_IMAGE=piping-ansible-runner:local
