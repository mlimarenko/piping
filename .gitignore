.playwright-mcp/
.playwright-cli/
output/playwright/
.bench/
trivy-reports/
.token-optimizer/

# Agent / tool runtime state (never belongs in the product repo)
.claude/
.omx/

# Lint / format caches
.ruff_cache/

# Merge / patch conflict leftovers
*.orig
*.rej

# Ansible collection install metadata (vendored galaxy deps)
.galaxy_install_info
